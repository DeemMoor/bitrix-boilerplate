#!/usr/bin/env bash
#
# Bitrix Boilerplate — интерактивный установщик.
#
# Одна команда с нуля (curl-режим):
#   bash <(curl -fsSL https://github.com/DeemMoor/bitrix-boilerplate/raw/master/scripts/bootstrap)
#
# Из склонированного репозитория:
#   ./scripts/bootstrap
#
# После composer create-project запускается автоматически (--from-composer).
#
# Мастер жёстко проверяет зависимости (git; для локалки — dl; для server/hosting —
# PHP >= 8.4, composer и установленный Битрикс) и при любой ошибке откатывает
# всё, что успел создать, — хвостов не остаётся.

set -Eeuo pipefail

ORIG_PWD="$PWD"
DEFAULT_REPO_URL="https://github.com/DeemMoor/bitrix-boilerplate.git"
PHP_MIN_VERSION="8.4"
PHP_MIN_VERSION_ID=80400

# ---------------------------------------------------------------------------
# Цвета и вывод
# ---------------------------------------------------------------------------

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    C_RESET=$'\033[0m'
    C_TITLE=$'\033[1;36m'
    C_CYAN=$'\033[36m'
    C_GREEN=$'\033[32m'
    C_YELLOW=$'\033[33m'
    C_RED=$'\033[31m'
    C_DIM=$'\033[2m'
else
    C_RESET='' C_TITLE='' C_CYAN='' C_GREEN='' C_YELLOW='' C_RED='' C_DIM=''
fi

say()  { printf '%s\n' "$1"; }
ok()   { printf '%s\n' "${C_GREEN}[OK]${C_RESET} $1"; }
info() { printf '%s\n' "${C_DIM}$1${C_RESET}"; }
warn() { printf '%s\n' "${C_YELLOW}[WARN]${C_RESET} $1" >&2; }
err()  { printf '%s\n' "${C_RED}[ERROR]${C_RESET} $1" >&2; }

die() {
    err "$1"
    if [[ -n "${2:-}" ]]; then
        printf '%s\n' "        $2" >&2
    fi
    exit 1
}

banner() {
    printf '%s' "${C_TITLE}"
    cat <<'EOF'
 ██████╗ ██╗████████╗██████╗ ██╗██╗  ██╗
 ██╔══██╗██║╚══██╔══╝██╔══██╗██║╚██╗██╔╝
 ██████╔╝██║   ██║   ██████╔╝██║ ╚███╔╝
 ██╔══██╗██║   ██║   ██╔══██╗██║ ██╔██╗
 ██████╔╝██║   ██║   ██║  ██║██║██╔╝ ██╗
 ╚═════╝ ╚═╝   ╚═╝   ╚═╝  ╚═╝╚═╝╚═╝  ╚═╝
EOF
    printf '%s\n' "${C_RESET}${C_GREEN}        B O I L E R P L A T E${C_RESET}"
    printf '%s\n' "${C_DIM}       интерактивная установка${C_RESET}"
}


QUESTION_N=1
QUESTION_TOTAL=8

section() { # section "База данных"
    printf '\n%s\n' "${C_TITLE}[${QUESTION_N}/${QUESTION_TOTAL}] $1${C_RESET}"
    QUESTION_N=$((QUESTION_N + 1))
}

# ---------------------------------------------------------------------------
# Ввод: вопросы с дефолтами, меню, y/n
# ---------------------------------------------------------------------------

INTERACTIVE=0
if [[ -t 0 ]]; then
    INTERACTIVE=1
fi

# ask_value VAR "Вопрос" "дефолт" "regex" "подсказка при ошибке"
ask_value() {
    local var="$1" question="$2" default="$3" regex="${4:-}" hint="${5:-}" answer
    if [[ -n "${!var}" ]]; then
        if [[ -n "$regex" && ! "${!var}" =~ $regex ]]; then
            die "Недопустимое значение «${!var}» (${question})." "$hint"
        fi
        return
    fi
    if [[ "$INTERACTIVE" -ne 1 || "$ASSUME_YES" -eq 1 ]]; then
        if [[ -n "$regex" && ! "$default" =~ $regex ]]; then
            die "Недопустимое значение по умолчанию «${default}» (${question})." "$hint"
        fi
        printf -v "$var" '%s' "$default"
        return
    fi
    while true; do
        printf '%s' "${C_CYAN}${question}${C_RESET} ${C_DIM}[${default}]${C_RESET}: "
        read -r answer
        answer="${answer:-$default}"
        if [[ -z "$regex" || "$answer" =~ $regex ]]; then
            printf -v "$var" '%s' "$answer"
            return
        fi
        err "Недопустимое значение. ${hint}"
    done
}

# ask_yn VAR "Вопрос" y|n  → VAR=1|0
ask_yn() {
    local var="$1" question="$2" default="$3" suffix answer
    if [[ -n "${!var}" ]]; then
        return
    fi
    if [[ "$INTERACTIVE" -ne 1 || "$ASSUME_YES" -eq 1 ]]; then
        if [[ "$default" == y ]]; then printf -v "$var" '1'; else printf -v "$var" '0'; fi
        return
    fi
    if [[ "$default" == y ]]; then
        suffix="[${C_GREEN}Y${C_RESET}/n]"
    else
        suffix="[y/${C_GREEN}N${C_RESET}]"
    fi
    printf '%s' "${C_CYAN}${question}${C_RESET} ${suffix} "
    read -r answer
    answer="${answer:-$default}"
    case "$answer" in
        y|Y|yes|YES|д|Д) printf -v "$var" '1' ;;
        *)               printf -v "$var" '0' ;;
    esac
}

# ask_menu VAR "Вопрос" default_index "пункт1" "пункт2" ... → VAR=выбранный индекс (с 1)
ask_menu() {
    local var="$1" question="$2" default="$3" i answer
    shift 3
    local options=("$@")
    if [[ -n "${!var}" ]]; then
        return
    fi
    if [[ "$INTERACTIVE" -ne 1 || "$ASSUME_YES" -eq 1 ]]; then
        printf -v "$var" '%s' "$default"
        return
    fi
    printf '%s\n' "${C_CYAN}${question}${C_RESET}"
    for i in "${!options[@]}"; do
        printf '  %s\n' "${C_TITLE}$((i + 1)))${C_RESET} ${options[$i]}"
    done
    while true; do
        printf '%s' "${C_CYAN}Выбор${C_RESET} ${C_DIM}[${default}]${C_RESET}: "
        read -r answer
        answer="${answer:-$default}"
        if [[ "$answer" =~ ^[0-9]+$ ]] && (( answer >= 1 && answer <= ${#options[@]} )); then
            printf -v "$var" '%s' "$answer"
            return
        fi
        err "Введите число от 1 до ${#options[@]}."
    done
}

# ---------------------------------------------------------------------------
# Откат: всё, что мастер создал, при ошибке удаляется, перезаписанное
# восстанавливается из бэкапа
# ---------------------------------------------------------------------------

TMP_DIR="$(mktemp -d)"
CLEANUP_PATHS=()        # созданные мастером файлы/каталоги — удалить при ошибке
RESTORE_PAIRS=()        # "backup|original" — вернуть перезаписанный файл при ошибке (cp)
FULL_RESTORE_PAIRS=()   # "backup|original" — вернуть целый каталог при ошибке (mv)
BACKUP_DIRS=()          # каталоги-бэкапы — удалить при любом исходе
BACKUP_SEQ=0
PROJECT_DIR_CREATED=""  # каталог, созданный мастером целиком, — снести при ошибке
DL_UP_DONE=0            # контейнеры подняты — перед откатом гасим dl down
RESTORE_KEEP_BACKUPS=0  # откат не удался — бэкапы не удаляем
CURRENT_STEP=""
CLEANUP_DONE=0

# rm -rf с честным итогом: docker-вольюмы внутри проекта принадлежат root,
# удалить их без sudo нельзя — не спамим ошибками, а говорим, что осталось.
rm_or_warn() {
    local path="$1"
    rm -rf "$path" 2>/dev/null || true
    if [[ -e "$path" || -L "$path" ]]; then
        warn "Не смог удалить полностью: ${path} (файлы docker-вольюмов созданы от root)."
        warn "Добейте вручную: sudo rm -rf '${path}'"
        return 1
    fi
    return 0
}

# Полный бэкап каталога для отката. Кладём рядом на том же ФС: cp -al
# (мгновенные hardlink'и, без расхода места) — ядро Битрикса на хостинге может
# весить гигабайты, и копировать его в /tmp (часто tmpfs с квотой) нельзя.
full_dir_backup() { # full_dir_backup <dir>
    local dir="$1" parent backup
    parent="$(dirname "$dir")"
    BACKUP_SEQ=$((BACKUP_SEQ + 1))
    if [[ -w "$parent" ]]; then
        backup="$parent/.bootstrap-rollback.$$.$BACKUP_SEQ"
    else
        backup="$TMP_DIR/rollback.$BACKUP_SEQ"
    fi
    if ! cp -al "$dir" "$backup" 2>/dev/null; then
        rm -rf "$backup"
        cp -a "$dir" "$backup"
    fi
    BACKUP_DIRS+=("$backup")
    FULL_RESTORE_PAIRS+=("$backup|$dir")
}

cleanup_on_fail() {
    if [[ "$CLEANUP_DONE" -eq 1 ]]; then
        return
    fi
    CLEANUP_DONE=1
    local path pair
    if [[ -z "$PROJECT_DIR_CREATED" \
          && "${#CLEANUP_PATHS[@]}" -eq 0 \
          && "${#RESTORE_PAIRS[@]}" -eq 0 \
          && "${#FULL_RESTORE_PAIRS[@]}" -eq 0 ]]; then
        return # ничего ещё не создали — чистить нечего
    fi
    warn "Подчищаю за собой..."
    if [[ "$DL_UP_DONE" -eq 1 && -n "$PROJECT_ROOT" && -d "$PROJECT_ROOT" ]]; then
        info "Останавливаю контейнеры: dl down"
        (cd "$PROJECT_ROOT" && dl down) >/dev/null 2>&1 || true
    fi
    cd /
    if [[ -n "$PROJECT_DIR_CREATED" ]]; then
        if rm_or_warn "$PROJECT_DIR_CREATED"; then
            info "Удалён каталог: $PROJECT_DIR_CREATED"
        fi
    fi
    for path in ${CLEANUP_PATHS[@]+"${CLEANUP_PATHS[@]}"}; do
        if [[ -e "$path" || -L "$path" ]]; then
            rm_or_warn "$path" || true
        fi
    done
    for pair in ${RESTORE_PAIRS[@]+"${RESTORE_PAIRS[@]}"}; do
        if [[ -e "${pair%%|*}" ]]; then
            rm -rf "${pair##*|}"
            cp -a "${pair%%|*}" "${pair##*|}"
        fi
    done
    for pair in ${FULL_RESTORE_PAIRS[@]+"${FULL_RESTORE_PAIRS[@]}"}; do
        if [[ -d "${pair%%|*}" ]]; then
            if rm_or_warn "${pair##*|}"; then
                mv "${pair%%|*}" "${pair##*|}"
            else
                warn "Откат каталога не завершён, бэкап оставлен: ${pair%%|*}"
                RESTORE_KEEP_BACKUPS=1
            fi
        fi
    done
    info "Созданные файлы удалены, перезаписанные восстановлены."
}

on_error() {
    local status=$?
    trap - ERR INT TERM
    if [[ -n "$CURRENT_STEP" ]]; then
        err "Шаг «${CURRENT_STEP}» завершился с ошибкой (код ${status}). Установка прервана."
    else
        err "Установка прервана (код ${status})."
    fi
    exit 1
}

on_exit() {
    local status=$?
    if [[ "$status" -ne 0 ]]; then
        cleanup_on_fail
    fi
    local backup
    if [[ "$RESTORE_KEEP_BACKUPS" -ne 1 ]]; then
        for backup in ${BACKUP_DIRS[@]+"${BACKUP_DIRS[@]}"}; do
            rm -rf "$backup"
        done
    fi
    rm -rf "$TMP_DIR"
}

trap on_error ERR
trap 'on_error' INT TERM
trap on_exit EXIT

# ---------------------------------------------------------------------------
# Проверки зависимостей — при отсутствии чего-либо падаем сразу и явно
# ---------------------------------------------------------------------------

PHP_BIN="${PHP_BIN:-}"

php_version_ok() {
    "$1" -r "exit(PHP_VERSION_ID >= ${PHP_MIN_VERSION_ID} ? 0 : 1);" >/dev/null 2>&1
}

check_base_deps() {
    if (( BASH_VERSINFO[0] < 4 )); then
        die "Нужен bash >= 4, у вас ${BASH_VERSION}."
    fi

    command -v git >/dev/null 2>&1 \
        || die "git не найден." "Установите git и запустите мастер снова."
    ok "git: $(command -v git)"
}

check_host_runtime_deps() {
    if [[ -n "$PHP_BIN" ]]; then
        command -v "$PHP_BIN" >/dev/null 2>&1 \
            || die "PHP_BIN=${PHP_BIN}: команда не найдена."
        php_version_ok "$PHP_BIN" \
            || die "PHP_BIN=${PHP_BIN} — версия $("$PHP_BIN" -r 'echo PHP_VERSION;' 2>/dev/null || echo '?'), нужен PHP >= ${PHP_MIN_VERSION}."
    else
        # На shared-хостингах системный php часто старый, рядом лежат php8.4/php8.5.
        local candidate
        for candidate in php php8.5 php8.4; do
            if command -v "$candidate" >/dev/null 2>&1 && php_version_ok "$candidate"; then
                PHP_BIN="$candidate"
                break
            fi
        done
        [[ -n "$PHP_BIN" ]] \
            || die "PHP >= ${PHP_MIN_VERSION} не найден (системный php: $(php -r 'echo PHP_VERSION;' 2>/dev/null || echo 'нет'))." \
                   "Установите PHP ${PHP_MIN_VERSION}+ или укажите бинарник: PHP_BIN=php8.4 bash scripts/bootstrap"
    fi
    ok "PHP: ${PHP_BIN} ($("$PHP_BIN" -r 'echo PHP_VERSION;'))"

    command -v composer >/dev/null 2>&1 \
        || die "composer не найден." "Установите composer (https://getcomposer.org/download/) и запустите мастер снова."
    ok "composer: $(command -v composer)"
}


check_dl() {
    command -v dl >/dev/null 2>&1 \
        || die "dl не найден — для локальной установки он обязателен." \
               "Установите DL: https://local-deploy.github.io/ru/getting-started/install"
    ok "dl: $(command -v dl)"
}

check_bitrix_installed() { # check_bitrix_installed <docroot>
    local docroot="$1"
    if [[ ! -f "$docroot/bitrix/modules/main/include.php" || ! -f "$docroot/bitrix/.settings.php" ]]; then
        die "В «${docroot}» не найден установленный Битрикс (нет bitrix/.settings.php или bitrix/modules/main)." \
            "Сначала установите ядро Битрикса, затем ставьте болванку поверх него."
    fi
    ok "Битрикс найден: ${docroot}/bitrix"
}

# dl exec принимает команду либо без флагов, либо одной строкой в кавычках
# (dl exec "composer install --no-interaction") — иначе съедает --флаги сам.
# Склеиваем аргументы в одну строку; токены с пробелами сюда не передавать.
dl_exec() {
    dl exec "$*"
}

# Запускает composer через подходящий PHP (на хостингах системный php бывает старым).
composer_cmd() {
    if [[ "$PHP_BIN" == "php" ]]; then
        composer "$@"
    else
        "$PHP_BIN" "$(command -v composer)" "$@"
    fi
}

# ---------------------------------------------------------------------------
# Аргументы
# ---------------------------------------------------------------------------

usage() {
    cat <<EOF
Bitrix Boilerplate — интерактивный установщик.

Использование:
  bash <(curl -fsSL https://github.com/DeemMoor/bitrix-boilerplate/raw/master/scripts/bootstrap) [флаги]
  ./scripts/bootstrap [флаги]

Без флагов задаёт вопросы. Всё, что задано флагом, не спрашивается.

Флаги:
  --target local|server|hosting
                           local = DL/Docker; server = свой сервер/VPS; hosting = shared-хостинг.
  --dir DIR                Каталог проекта. По умолчанию для local/server: .; для hosting: app
  --public-dir DIR         Docroot. server: public; hosting: public_html.
  --vendor NAME            Vendor: a-z, 0-9, _ (станет префиксом модуля <vendor>.engine).
  --name NAME              Имя пакета после vendor: a-z, 0-9, _, ., -
  --host-name NAME         HOST_NAME для .env. По умолчанию: название проекта.
  --db mysql|pgsql|mariadb Тип базы (только local; на server/hosting берётся из Битрикса).
  --db-version V           Версия БД (по умолчанию: mysql 8.4, pgsql 18, mariadb lts).
  --redis                  Включить Redis.
  --memcached              Включить Memcached.
  --redis-host H / --redis-port P / --memcached-host H / --memcached-port P
                           Адреса сервисов на server/hosting. По умолчанию: 127.0.0.1.
  --cache files|redis|memcache|none       Кэш Битрикса. По умолчанию: files
  --session file|database|redis|memcache  Сессии. По умолчанию: file
  --bitrix setup|deploy|skip  Локально: скачать bitrixsetup.php, выполнить dl deploy или пропустить.
  --server HOST / --server-user USER / --server-port PORT / --server-path PATH
                           Параметры .env для dl deploy.
  --strip-demo | --keep-demo  Удалить/оставить демо-код (на server/hosting удаляется всегда).
  --git | --no-git         git init + добавить файлы в индекс (без коммита). По умолчанию: git.
  --force                  Разрешить установку в непустой каталог и перезапись .env.
  --yes                    Неинтерактивный режим: дефолты для всего незаданного.
  --ref REF                Ветка/тег болванки. По умолчанию: master
  --repo-url URL           Репозиторий болванки. По умолчанию: ${DEFAULT_REPO_URL}
  --from-composer          Служебный: запуск из composer create-project.
  -h, --help               Эта справка.

Зависимости: всегда нужны bash >= 4 и git; для local нужен dl (PHP/Composer
запускаются через dl exec); для server/hosting нужны PHP >= ${PHP_MIN_VERSION},
composer и уже установленный Битрикс в docroot.
EOF
}

TARGET=""
PROJECT_DIR=""
DOCROOT=""
VENDOR=""
NAME=""
HOST_NAME_V=""
DB=""
DB_VERSION=""
WANT_REDIS=""
WANT_MEMCACHED=""
REDIS_HOST_V=""
REDIS_PORT_V=""
MEMCACHED_HOST_V=""
MEMCACHED_PORT_V=""
CACHE_V=""
SESSION_V=""
BITRIX_SOURCE=""
SERVER_V=""
SERVER_USER_V=""
SERVER_PORT_V=""
SERVER_PATH_V=""
STRIP_DEMO=""
GIT_INIT=""
FORCE=0
ASSUME_YES=0
REF="master"
REPO_URL="$DEFAULT_REPO_URL"
SOURCE_DIR=""
FROM_COMPOSER=0

# composer create-project не умеет передавать аргументы хуку —
# для неинтерактивных сценариев поддерживаем переменную BOOTSTRAP_ARGS.
if [[ "${1:-}" == "--from-composer" && -n "${BOOTSTRAP_ARGS:-}" ]]; then
    # shellcheck disable=SC2086
    set -- "$@" ${BOOTSTRAP_ARGS}
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        --target)         TARGET="${2:-}"; shift 2 ;;
        --dir)            PROJECT_DIR="${2:-}"; shift 2 ;;
        --public-dir|--docroot) DOCROOT="${2:-}"; shift 2 ;;
        --vendor)         VENDOR="${2:-}"; shift 2 ;;
        --name)           NAME="${2:-}"; shift 2 ;;
        --host-name)      HOST_NAME_V="${2:-}"; shift 2 ;;
        --db)             DB="${2:-}"; shift 2 ;;
        --db-version)     DB_VERSION="${2:-}"; shift 2 ;;
        --redis)          WANT_REDIS=1; shift ;;
        --memcached)      WANT_MEMCACHED=1; shift ;;
        --redis-host)     REDIS_HOST_V="${2:-}"; shift 2 ;;
        --redis-port)     REDIS_PORT_V="${2:-}"; shift 2 ;;
        --memcached-host) MEMCACHED_HOST_V="${2:-}"; shift 2 ;;
        --memcached-port) MEMCACHED_PORT_V="${2:-}"; shift 2 ;;
        --cache)          CACHE_V="${2:-}"; shift 2 ;;
        --session)        SESSION_V="${2:-}"; shift 2 ;;
        --bitrix)         BITRIX_SOURCE="${2:-}"; shift 2 ;;
        --setup-bitrix)   BITRIX_SOURCE="setup"; shift ;;
        --deploy-bitrix)  BITRIX_SOURCE="deploy"; shift ;;
        --skip-bitrix)    BITRIX_SOURCE="skip"; shift ;;
        --server)         SERVER_V="${2:-}"; shift 2 ;;
        --server-user)    SERVER_USER_V="${2:-}"; shift 2 ;;
        --server-port)    SERVER_PORT_V="${2:-}"; shift 2 ;;
        --server-path)    SERVER_PATH_V="${2:-}"; shift 2 ;;
        --strip-demo)     STRIP_DEMO=1; shift ;;
        --keep-demo)      STRIP_DEMO=0; shift ;;
        --git)            GIT_INIT=1; shift ;;
        --no-git)         GIT_INIT=0; shift ;;
        --force)          FORCE=1; shift ;;
        --yes)            ASSUME_YES=1; shift ;;
        --ref)            REF="${2:-}"; shift 2 ;;
        --repo-url)       REPO_URL="${2:-}"; shift 2 ;;
        --source-dir)     SOURCE_DIR="${2:-}"; shift 2 ;;
        --from-composer)  FROM_COMPOSER=1; shift ;;
        -h|--help)        usage; exit 0 ;;
        *)                die "Неизвестный флаг: $1" "Список флагов: ./scripts/bootstrap --help" ;;
    esac
done

case "$TARGET" in ''|local|server|hosting) ;; *) die "--target: допустимо local, server или hosting, получено «${TARGET}»." ;; esac
case "$DB" in ''|mysql|pgsql|mariadb) ;; *) die "--db: допустимо mysql, pgsql или mariadb, получено «${DB}»." ;; esac
case "$CACHE_V" in ''|files|redis|memcache|none) ;; *) die "--cache: допустимо files, redis, memcache или none." ;; esac
case "$SESSION_V" in ''|file|database|redis|memcache) ;; *) die "--session: допустимо file, database, redis или memcache." ;; esac
case "$BITRIX_SOURCE" in ''|setup|deploy|skip) ;; *) die "--bitrix: допустимо setup, deploy или skip." ;; esac

if [[ "$INTERACTIVE" -ne 1 && "$ASSUME_YES" -ne 1 ]]; then
    die "stdin не терминал: интерактивные вопросы невозможны." \
        "Добавьте --yes (дефолты для незаданного) и задайте нужное флагами: --target, --dir/--public-dir, --vendor, --name, --db, --cache, --session, --strip-demo/--keep-demo, --git/--no-git."
fi

# ---------------------------------------------------------------------------
# Режим запуска: curl (remote), из репозитория (repo) или composer-хук
# ---------------------------------------------------------------------------

MODE="remote"
PROJECT_ROOT=""
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P || true)"

if [[ "$FROM_COMPOSER" -eq 1 ]]; then
    MODE="composer"
    PROJECT_ROOT="$PWD"
elif [[ -z "$SOURCE_DIR" && -n "$SCRIPT_DIR" && -f "$SCRIPT_DIR/init" && -f "$SCRIPT_DIR/../composer.json" ]]; then
    MODE="repo"
    PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
fi

banner
say ""
info "Enter — принять значение в скобках, Ctrl+C — выход."
say ""
say "${C_TITLE}Проверка зависимостей${C_RESET}"
check_base_deps

# ---------------------------------------------------------------------------
# Вопросы
# ---------------------------------------------------------------------------

TARGET_CHOICE=""
if [[ "$TARGET" == "local" ]]; then TARGET_CHOICE=1; fi
if [[ "$TARGET" == "server" ]]; then TARGET_CHOICE=2; fi
if [[ "$TARGET" == "hosting" ]]; then TARGET_CHOICE=3; fi
printf '\n%s\n' "${C_TITLE}Куда ставим болванку?${C_RESET}"
ask_menu TARGET_CHOICE "Вариант установки" 1 \
    "Локальная разработка" \
    "Свой сервер / VPS" \
    "Shared-хостинг"
case "$TARGET_CHOICE" in
    1) TARGET="local" ;;
    2) TARGET="server" ;;
    3) TARGET="hosting" ;;
esac

if [[ "$TARGET" == "local" ]]; then
    check_dl
    QUESTION_TOTAL=9
    if [[ "$MODE" != "remote" ]]; then
        QUESTION_TOTAL=8
    fi
else
    check_host_runtime_deps
    QUESTION_TOTAL=6
fi

# --- Каталог проекта / docroot ----------------------------------------------
if [[ "$MODE" == "remote" ]]; then
    if [[ "$TARGET" == "hosting" ]]; then
        section "Каталоги хостинга"
        ask_value PROJECT_DIR "Каталог для кода" "app" '^[A-Za-z0-9._/-]+$' \
            "Только буквы, цифры, точки, дефисы и подчёркивания."
        ask_value DOCROOT "Docroot с установленным Битриксом" "public_html" '' ''
    else
        section "Каталог проекта"
        ask_value PROJECT_DIR "Каталог установки" "." '^[A-Za-z0-9._/-]+$' \
            "Только буквы, цифры, точки, дефисы и подчёркивания."
        if [[ "$TARGET" == "server" ]]; then
            ask_value DOCROOT "Docroot сервера с установленным Битриксом" "public" '' ''
        fi
    fi

    if [[ "$PROJECT_DIR" != /* ]]; then
        PROJECT_DIR="$PWD/${PROJECT_DIR%/}"
    fi
    if [[ -e "$PROJECT_DIR" ]]; then
        if [[ ! -d "$PROJECT_DIR" ]]; then
            die "Путь уже существует и это не каталог: ${PROJECT_DIR}."
        fi
        # Канонизируем (например, --dir . даёт «/path/.»), иначе бэкап отката
        # посчитает родителем сам каталог и попытается скопировать его в себя.
        PROJECT_DIR="$(cd "$PROJECT_DIR" && pwd -P)"
        if [[ "$TARGET" == "local" && -n "$(find "$PROJECT_DIR" -mindepth 1 -maxdepth 1 -print -quit)" && "$FORCE" -ne 1 ]]; then
            die "Каталог уже не пустой: ${PROJECT_DIR}." \
                "Выберите пустой каталог, новую папку или добавьте --force, если точно хотите писать поверх."
        fi
    fi

    if [[ "$TARGET" == "server" ]]; then
        if [[ "$DOCROOT" != /* ]]; then
            DOCROOT="$PROJECT_DIR/${DOCROOT%/}"
        fi
        [[ -d "$DOCROOT" ]] || die "Каталог docroot не найден: ${DOCROOT}."
        DOCROOT="$(cd "$DOCROOT" && pwd -P)"
        check_bitrix_installed "$DOCROOT"
    elif [[ "$TARGET" == "hosting" ]]; then
        if [[ "$DOCROOT" != /* ]]; then
            DOCROOT="$PWD/${DOCROOT%/}"
        fi
        [[ -d "$DOCROOT" ]] || die "Каталог docroot не найден: ${DOCROOT}."
        DOCROOT="$(cd "$DOCROOT" && pwd -P)"
        check_bitrix_installed "$DOCROOT"
    fi
else
    # repo/composer: файлы уже в корне проекта.
    PROJECT_DIR="$PROJECT_ROOT"
    if [[ "$TARGET" == "server" ]]; then
        DOCROOT="$PROJECT_ROOT/public"
        section "Каталог сайта"
        check_bitrix_installed "$DOCROOT"
    elif [[ "$TARGET" == "hosting" ]]; then
        section "Каталог сайта"
        ask_value DOCROOT "Public docroot хостинга с установленным Битриксом" "public_html" '' ''
        if [[ "$DOCROOT" != /* ]]; then
            DOCROOT="$PWD/${DOCROOT%/}"
        fi
        [[ -d "$DOCROOT" ]] || die "Каталог docroot не найден: ${DOCROOT}."
        DOCROOT="$(cd "$DOCROOT" && pwd -P)"
        check_bitrix_installed "$DOCROOT"
    fi
fi

# .env на месте установки: без --force в неинтерактивном режиме не перезаписываем.
ENV_TARGET_DIR="$PROJECT_ROOT"
if [[ "$MODE" == "remote" ]]; then
    ENV_TARGET_DIR="$PROJECT_DIR"
fi
if [[ -f "$ENV_TARGET_DIR/.env" && "$FORCE" -ne 1 && "$ASSUME_YES" -eq 1 ]]; then
    die "В ${ENV_TARGET_DIR} уже есть .env." "Добавьте --force, чтобы перезаписать его ответами мастера."
fi

# --- Vendor и название -------------------------------------------------------
section "Vendor и composer-name"
default_name="project"
if [[ -n "$PROJECT_DIR" ]]; then
    default_name="$(basename "$PROJECT_DIR" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9_.-')"
elif [[ -n "$DOCROOT" ]]; then
    default_name="$(basename "$(dirname "$DOCROOT")" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9_.-')"
fi
if [[ -z "$default_name" || ! "$default_name" =~ ^[a-z] ]]; then
    default_name="project"
fi

info "Из ответов соберётся имя composer-пакета vendor/name и модуль <vendor>.engine."
ask_value VENDOR "Vendor" "vendor" '^[a-z][a-z0-9_]*$' \
    "Строчные латинские буквы, цифры и _, первая — буква."
ask_value NAME "Название проекта" "$default_name" '^[a-z][a-z0-9_.-]*$' \
    "Строчные латинские буквы, цифры, точки, дефисы и _, первая — буква."
ask_value HOST_NAME_V "HOST_NAME" "$NAME" '^[a-z0-9][a-z0-9.-]*$' \
    "Строчные буквы, цифры, точки и дефисы."

# --- База данных -------------------------------------------------------------
if [[ "$TARGET" == "local" ]]; then
    section "База данных"
    DB_CHOICE=""
    case "$DB" in mysql) DB_CHOICE=1 ;; pgsql) DB_CHOICE=2 ;; mariadb) DB_CHOICE=3 ;; esac
    ask_menu DB_CHOICE "Какая база данных?" 1 "MySQL" "PostgreSQL" "MariaDB"
    case "$DB_CHOICE" in
        1) DB="mysql" ;;
        2) DB="pgsql" ;;
        3) DB="mariadb" ;;
    esac
    case "$DB" in
        mysql)   db_ver_default="8.4" ;;
        pgsql)   db_ver_default="18" ;;
        mariadb) db_ver_default="lts" ;;
    esac
    ask_value DB_VERSION "Версия ${DB}" "$db_ver_default" '^[A-Za-z0-9.-]+$' "Например: ${db_ver_default}"
    info "Креды БД для локалки под dl: db/db/db (меняются в .env)."
else
    # На server/hosting тип и креды БД init берёт из bitrix/.settings.php —
    # вопросы не нужны, тип определяем сами только ради CONNECTIONS.
    if grep -q 'Pgsql' "$DOCROOT/bitrix/.settings.php" 2>/dev/null; then
        DB="pgsql"
    else
        DB="mysql"
    fi
    info "База данных: ${DB} (тип и креды возьмутся из bitrix/.settings.php)."
fi

# --- Источник Битрикса для локалки --------------------------------------------
if [[ "$TARGET" == "local" ]]; then
    section "Битрикс локально"
    BITRIX_CHOICE=""
    case "$BITRIX_SOURCE" in setup) BITRIX_CHOICE=1 ;; deploy) BITRIX_CHOICE=2 ;; skip) BITRIX_CHOICE=3 ;; esac
    ask_menu BITRIX_CHOICE "Что сделать с ядром и базой после запуска контейнеров?" 1 \
        "Скачать bitrixsetup.php для ручной установки" \
        "Выполнить dl deploy: забрать ядро и базу с сервера" \
        "Пропустить"
    case "$BITRIX_CHOICE" in
        1) BITRIX_SOURCE="setup" ;;
        2) BITRIX_SOURCE="deploy" ;;
        3) BITRIX_SOURCE="skip" ;;
    esac
    if [[ "$BITRIX_SOURCE" == "deploy" ]]; then
        ask_value SERVER_V "SERVER для dl deploy" "127.0.0.1" '^[A-Za-z0-9._-]+$' "Хост или IP."
        ask_value SERVER_USER_V "USER_SRV для dl deploy" "user" '^[A-Za-z0-9._-]+$' "Пользователь SSH."
        ask_value SERVER_PORT_V "PORT_SRV для dl deploy" "22" '^[0-9]+$' "Порт SSH."
        ask_value SERVER_PATH_V "CATALOG_SRV на сервере" "/var/www/html" '^/.+' "Абсолютный путь на сервере."
    fi
fi

# --- Сервисы -------------------------------------------------------------------
section "Сервисы"
ask_yn WANT_REDIS "Нужен Redis?" n
ask_yn WANT_MEMCACHED "Нужен Memcached?" n
if [[ "$TARGET" != "local" ]]; then
    if [[ "$WANT_REDIS" -eq 1 ]]; then
        ask_value REDIS_HOST_V "Хост Redis" "127.0.0.1" '^[A-Za-z0-9._/-]+$' ''
        ask_value REDIS_PORT_V "Порт Redis" "6379" '^[0-9]+$' "Число."
    fi
    if [[ "$WANT_MEMCACHED" -eq 1 ]]; then
        ask_value MEMCACHED_HOST_V "Хост Memcached" "127.0.0.1" '^[A-Za-z0-9._/-]+$' ''
        ask_value MEMCACHED_PORT_V "Порт Memcached" "11211" '^[0-9]+$' "Число."
    fi
fi

# --- Кэш и сессии ----------------------------------------------------------------
section "Кэш Битрикса"
cache_options=("files" "none")
if [[ "$WANT_REDIS" -eq 1 ]]; then cache_options+=("redis"); fi
if [[ "$WANT_MEMCACHED" -eq 1 ]]; then cache_options+=("memcache"); fi
if [[ -n "$CACHE_V" ]]; then
    case "$CACHE_V" in
        redis)    [[ "$WANT_REDIS" -eq 1 ]] || die "--cache redis требует --redis." ;;
        memcache) [[ "$WANT_MEMCACHED" -eq 1 ]] || die "--cache memcache требует --memcached." ;;
    esac
    info "Кэш: ${CACHE_V}"
else
    CACHE_CHOICE=""
    ask_menu CACHE_CHOICE "Где хранить кэш?" 1 "${cache_options[@]}"
    CACHE_V="${cache_options[$((CACHE_CHOICE - 1))]}"
fi

section "Сессии"
session_options=("file" "database")
if [[ "$WANT_REDIS" -eq 1 ]]; then session_options+=("redis"); fi
if [[ "$WANT_MEMCACHED" -eq 1 ]]; then session_options+=("memcache"); fi
if [[ -n "$SESSION_V" ]]; then
    case "$SESSION_V" in
        redis)    [[ "$WANT_REDIS" -eq 1 ]] || die "--session redis требует --redis." ;;
        memcache) [[ "$WANT_MEMCACHED" -eq 1 ]] || die "--session memcache требует --memcached." ;;
    esac
    info "Сессии: ${SESSION_V}"
else
    SESSION_CHOICE=""
    ask_menu SESSION_CHOICE "Где хранить сессии?" 1 "${session_options[@]}"
    SESSION_V="${session_options[$((SESSION_CHOICE - 1))]}"
fi

# --- Демо-данные -----------------------------------------------------------------
if [[ "$TARGET" != "local" ]]; then
    if [[ "$STRIP_DEMO" == "0" ]]; then
        die "--keep-demo недоступен для server/hosting: на проде демо-данные удаляются всегда."
    fi
    STRIP_DEMO=1
    info "Продовая установка: демо-срез (Example, /api/example, /api/test, ping) будет удалён."
else
    section "Демо-данные"
    info "Демо-срез: сущность Example, эндпоинты /api/example и /api/test, команда ping."
    ask_yn STRIP_DEMO "Удалить демо-данные?" n
fi

# --- Git ---------------------------------------------------------------------------
section "Git"
info "Мастер только инициализирует репозиторий и добавит файлы в индекс — коммит за вами."
ask_yn GIT_INIT "Инициализировать git-репозиторий?" y

# ---------------------------------------------------------------------------
# Резюме и подтверждение
# ---------------------------------------------------------------------------

summary_line() { printf '  %s%-14s%s %s\n' "$C_DIM" "$1" "$C_RESET" "$2"; }

say ""
say "${C_TITLE}Итого:${C_RESET}"
if [[ "$TARGET" == "local" ]]; then
    summary_line "Цель:" "локальная разработка (DL)"
    summary_line "Каталог:" "${PROJECT_DIR}"
    summary_line "БД:" "${DB} ${DB_VERSION}"
    case "$BITRIX_SOURCE" in
        setup) summary_line "Битрикс:" "скачать bitrixsetup.php" ;;
        deploy) summary_line "Битрикс:" "dl deploy с ${SERVER_V}" ;;
        skip) summary_line "Битрикс:" "пропустить" ;;
    esac
elif [[ "$TARGET" == "server" ]]; then
    summary_line "Цель:" "свой сервер/VPS"
    summary_line "Каталог:" "${PROJECT_DIR}"
    summary_line "Docroot:" "${DOCROOT}"
    summary_line "БД:" "${DB} (из bitrix/.settings.php)"
else
    summary_line "Цель:" "shared-хостинг"
    summary_line "Каталог:" "${PROJECT_DIR}"
    summary_line "Docroot:" "${DOCROOT} → ${PROJECT_DIR}/public"
    summary_line "БД:" "${DB} (из bitrix/.settings.php)"
fi
summary_line "Проект:" "${VENDOR}/${NAME} (модуль ${VENDOR}.engine)"
summary_line "HOST_NAME:" "${HOST_NAME_V}"
summary_line "Redis:" "$(if [[ "$WANT_REDIS" -eq 1 ]]; then echo да; else echo нет; fi)"
summary_line "Memcached:" "$(if [[ "$WANT_MEMCACHED" -eq 1 ]]; then echo да; else echo нет; fi)"
summary_line "Кэш/сессии:" "${CACHE_V} / ${SESSION_V}"
summary_line "Демо-данные:" "$(if [[ "$STRIP_DEMO" -eq 1 ]]; then echo удалить; else echo оставить; fi)"
summary_line "Git:" "$(if [[ "$GIT_INIT" -eq 1 ]]; then echo "init + add, без коммита"; else echo нет; fi)"
say ""

if [[ "$INTERACTIVE" -eq 1 && "$ASSUME_YES" -ne 1 ]]; then
    CONFIRM=""
    ask_yn CONFIRM "Поехали?" y
    if [[ "$CONFIRM" -ne 1 ]]; then
        say "Отменено. Ничего не изменено."
        exit 0
    fi
fi

# ---------------------------------------------------------------------------
# Выполнение
# ---------------------------------------------------------------------------

STEP_N=0
STEP_TOTAL=3
if [[ "$MODE" == "remote" ]]; then STEP_TOTAL=$((STEP_TOTAL + 1)); fi
if [[ "$TARGET" == "local" ]]; then STEP_TOTAL=$((STEP_TOTAL + 1)); fi
if [[ "$TARGET" == "local" && "$BITRIX_SOURCE" != "skip" ]]; then STEP_TOTAL=$((STEP_TOTAL + 1)); fi
if [[ "$STRIP_DEMO" -eq 1 ]]; then STEP_TOTAL=$((STEP_TOTAL + 1)); fi
if [[ "$GIT_INIT" -eq 1 ]]; then STEP_TOTAL=$((STEP_TOTAL + 1)); fi
RENAMED_MODULE_PREEXISTED=0

step() {
    STEP_N=$((STEP_N + 1))
    CURRENT_STEP="$1"
    printf '\n%s\n' "${C_TITLE}[${STEP_N}/${STEP_TOTAL}] $1${C_RESET}"
}

# --- Шаг: файлы болванки -------------------------------------------------------
if [[ "$MODE" == "remote" ]]; then
    step "Установка файлов болванки"
    if [[ -n "$SOURCE_DIR" ]]; then
        SRC="$(cd "$SOURCE_DIR" && pwd -P)"
        info "Источник: ${SRC}"
    else
        info "git clone --depth 1 --branch ${REF} ${REPO_URL}"
        git clone --quiet --depth 1 --branch "$REF" "$REPO_URL" "$TMP_DIR/src"
        SRC="$TMP_DIR/src"
    fi

    if [[ "$VENDOR" != "vendor" && -d "$PROJECT_DIR/local/modules/${VENDOR}.engine" ]]; then
        RENAMED_MODULE_PREEXISTED=1
    fi

    # Откат: новый каталог сносим целиком, существующий (и docroot хостинга,
    # откуда переезжают bitrix/upload) возвращаем из полного бэкапа.
    INSTALL_ARGS=()
    if [[ -e "$PROJECT_DIR" ]]; then
        full_dir_backup "$PROJECT_DIR"
        INSTALL_ARGS+=(--force)
    else
        PROJECT_DIR_CREATED="$PROJECT_DIR"
    fi

    if [[ "$TARGET" == "local" ]]; then
        bash "$SRC/scripts/install.sh" --from-dir "$SRC" --dir "$PROJECT_DIR" \
            ${INSTALL_ARGS[@]+"${INSTALL_ARGS[@]}"}
    elif [[ "$TARGET" == "server" ]]; then
        bash "$SRC/scripts/install.sh" --from-dir "$SRC" --dir "$PROJECT_DIR" \
            --link-public-dir --force
    else
        full_dir_backup "$DOCROOT"
        bash "$SRC/scripts/install.sh" --from-dir "$SRC" --dir "$PROJECT_DIR" \
            --public-dir "$DOCROOT" --link-public-dir --force
    fi
    PROJECT_ROOT="$PROJECT_DIR"
    ok "Файлы разложены: ${PROJECT_ROOT}"
else
    # repo/composer: файлы уже на месте, под откат берём только то, что будем менять.
    for rel in composer.json composer.lock console tests local/modules/vendor.engine \
               local/.settings.php local/php_interface/dbconn.php .env; do
        if [[ -e "$PROJECT_ROOT/$rel" ]]; then
            mkdir -p "$TMP_DIR/backup/$(dirname "$rel")"
            cp -a "$PROJECT_ROOT/$rel" "$TMP_DIR/backup/$rel"
            RESTORE_PAIRS+=("$TMP_DIR/backup/$rel|$PROJECT_ROOT/$rel")
        else
            CLEANUP_PATHS+=("$PROJECT_ROOT/$rel")
        fi
    done
    if [[ "$VENDOR" != "vendor" ]]; then
        CLEANUP_PATHS+=("$PROJECT_ROOT/local/modules/${VENDOR}.engine")
    fi
fi

cd "$PROJECT_ROOT"

# --- Шаг: .env -------------------------------------------------------------------
step "Генерация .env"

env_set() { # env_set KEY VALUE — раскомментирует ключ и ставит значение (или добавляет в конец)
    local key="$1" value="$2"
    awk -v key="$key" -v val="$value" '
        BEGIN { done = 0 }
        !done && $0 ~ ("^[#[:space:]]*" key "=") { print key "=" val; done = 1; next }
        { print }
        END { if (!done) print key "=" val }
    ' .env > .env.bootstrap.tmp && mv .env.bootstrap.tmp .env
}

env_comment() { # env_comment KEY — закомментировать ключ
    local key="$1"
    awk -v key="$key" '
        $0 ~ ("^" key "=") { print "# " $0; next }
        { print }
    ' .env > .env.bootstrap.tmp && mv .env.bootstrap.tmp .env
}

SKIP_ENV=0
if [[ -f .env ]]; then
    if [[ "$FORCE" -eq 1 || "$ASSUME_YES" -eq 1 ]]; then
        warn ".env уже существует — перезаписываю (при ошибке вернётся из бэкапа)."
    else
        OVERWRITE_ENV=""
        ask_yn OVERWRITE_ENV ".env уже существует. Перезаписать ответами мастера?" n
        if [[ "$OVERWRITE_ENV" -ne 1 ]]; then
            SKIP_ENV=1
            warn "Оставляю существующий .env — настройки возьмутся из него."
        fi
    fi
fi

if [[ "$SKIP_ENV" -eq 0 ]]; then
    # Пишем через tmp+mv: прямая перезапись существующего .env испортила бы
    # hardlink-бэкап отката при повторном запуске.
    cp .env.example .env.bootstrap.tmp && mv .env.bootstrap.tmp .env

    env_set PROJECT_NAME "${VENDOR}/${NAME}"
    env_set HOST_NAME "${HOST_NAME_V}"

    if [[ "$BITRIX_SOURCE" == "deploy" ]]; then
        env_set SERVER "${SERVER_V}"
        env_set USER_SRV "${SERVER_USER_V}"
        env_set PORT_SRV "${SERVER_PORT_V}"
        env_set CATALOG_SRV "${SERVER_PATH_V}"
    fi

    if [[ "$TARGET" != "local" ]]; then
        env_set APP_ENV "production"
        env_set APP_DEBUG "false"
        env_set DOCUMENT_ROOT "${DOCROOT}"
    else
        env_set APP_ENV "local"
        env_set APP_DEBUG "true"
        case "$DB" in
            mysql)
                env_set MYSQL_VERSION "${DB_VERSION}"
                ;;
            pgsql)
                env_comment MYSQL_VERSION
                env_set POSTGRES_VERSION "${DB_VERSION}"
                env_set POSTGRES_DB "db"
                env_set POSTGRES_USER "db"
                env_set POSTGRES_PASSWORD "db"
                ;;
            mariadb)
                env_comment MYSQL_VERSION
                env_set MARIADB_VERSION "${DB_VERSION}"
                ;;
        esac
        php_modules="opcache"
        if [[ "$WANT_REDIS" -eq 1 ]]; then php_modules+=" redis"; fi
        if [[ "$WANT_MEMCACHED" -eq 1 ]]; then php_modules+=" memcached"; fi
        env_set PHP_MODULES "\"${php_modules}\""
    fi

    if [[ "$WANT_REDIS" -eq 1 ]]; then
        env_set REDIS "true"
        if [[ -n "$REDIS_HOST_V" ]]; then env_set REDIS_HOST "$REDIS_HOST_V"; fi
        if [[ -n "$REDIS_PORT_V" ]]; then env_set REDIS_PORT "$REDIS_PORT_V"; fi
    fi
    if [[ "$WANT_MEMCACHED" -eq 1 ]]; then
        env_set MEMCACHED "true"
        if [[ -n "$MEMCACHED_HOST_V" ]]; then env_set MEMCACHED_HOST "$MEMCACHED_HOST_V"; fi
        if [[ -n "$MEMCACHED_PORT_V" ]]; then env_set MEMCACHED_PORT "$MEMCACHED_PORT_V"; fi
    fi

    env_set CACHE "${CACHE_V}"
    env_set SESSION "${SESSION_V}"
    connections="${DB}"
    if [[ "$WANT_REDIS" -eq 1 ]]; then connections+=",redis"; fi
    if [[ "$WANT_MEMCACHED" -eq 1 ]]; then connections+=",memcache"; fi
    env_set CONNECTIONS "[${connections}]"

    if [[ -n "$PHP_BIN" && "$PHP_BIN" != "php" ]]; then
        env_set PHP_BIN "$PHP_BIN"
    fi

    ok ".env создан."
fi

# --- Шаг: запуск локальных контейнеров ---------------------------------------------
if [[ "$TARGET" == "local" ]]; then
    step "Запуск контейнеров (dl up)"
    # Контейнеры от прошлой установки могли держать bind-mount на старый,
    # уже пересозданный каталог проекта (внутри он выглядит пустым, сайт
    # отвечает «File not found»). Перед up честно перезапускаем стек;
    # данные БД живут в .docker/volume и down их не трогает.
    dl down >/dev/null 2>&1 || true
    dl up
    DL_UP_DONE=1
    ok "Контейнеры запущены."

    case "$BITRIX_SOURCE" in
        setup)
            step "Скачивание bitrixsetup.php"
            bash scripts/setup
            ok "bitrixsetup.php скачан в public/."
            ;;
        deploy)
            step "Загрузка ядра и базы (dl deploy)"
            dl deploy
            ok "Ядро и база загружены через dl deploy."
            ;;
    esac
fi

# --- Шаг: демо-данные ---------------------------------------------------------------
if [[ "$STRIP_DEMO" -eq 1 ]]; then
    step "Удаление демо-данных"
    if [[ -d local/modules/vendor.engine ]]; then
        if [[ "$TARGET" == "local" ]]; then
            dl_exec php scripts/strip-demo.php
        else
            "$PHP_BIN" scripts/strip-demo.php
        fi
        ok "Демо-срез удалён, каркас модуля сохранён."
    else
        info "Модуль vendor.engine не найден (уже переименован или очищен) — пропускаю."
    fi
fi

if [[ "$RENAMED_MODULE_PREEXISTED" -eq 1 && -d "local/modules/${VENDOR}.engine" && -d local/modules/vendor.engine ]]; then
    info "Модуль ${VENDOR}.engine уже был в проекте — убираю повторно скопированный vendor.engine."
    rm -rf local/modules/vendor.engine
    # Через временный файл в проекте: dl exec не пропускает флаги вроде php -r
    # и не пробрасывает переменные окружения в контейнер.
    cat > .bootstrap-fix-psr4.php <<'PHP'
<?php
$vendor = $argv[1];
$namespaceVendor = str_replace(' ', '', ucwords(str_replace(['-', '_'], ' ', $vendor)));
$composerFile = 'composer.json';
$json = json_decode(file_get_contents($composerFile), true, 512, JSON_THROW_ON_ERROR);
if (isset($json['autoload']['psr-4']['Vendor\\Engine\\'])) {
    unset($json['autoload']['psr-4']['Vendor\\Engine\\']);
    $json['autoload']['psr-4'][$namespaceVendor . '\\Engine\\'] = 'local/modules/' . $vendor . '.engine/lib';
    file_put_contents(
        $composerFile,
        json_encode($json, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) . PHP_EOL
    );
}
PHP
    if [[ "$TARGET" == "local" ]]; then
        dl_exec php .bootstrap-fix-psr4.php "$VENDOR"
    else
        "$PHP_BIN" .bootstrap-fix-psr4.php "$VENDOR"
    fi
    rm -f .bootstrap-fix-psr4.php
fi

# --- Шаг: init ----------------------------------------------------------------------
step "Инициализация проекта (scripts/init)"
INIT_ARGS=()
if [[ -f local/.settings.php ]]; then
    INIT_ARGS=(--force)
fi
if [[ "$TARGET" == "local" ]]; then
    dl_exec bash scripts/init ${INIT_ARGS[@]+"${INIT_ARGS[@]}"}
else
    PHP_BIN="$PHP_BIN" bash scripts/init ${INIT_ARGS[@]+"${INIT_ARGS[@]}"}
fi

# --- Шаг: composer --------------------------------------------------------------------
step "Composer-зависимости"
if [[ ! -d vendor ]]; then
    CLEANUP_PATHS+=("$PROJECT_ROOT/vendor")
fi
if [[ "$TARGET" == "local" ]]; then
    if [[ "$MODE" == "composer" ]]; then
        dl_exec composer dump-autoload --quiet
        ok "Автозагрузка пересобрана в контейнере."
    else
        dl_exec composer install --no-interaction
        ok "Зависимости установлены в контейнере."
    fi
elif [[ "$MODE" == "composer" ]]; then
    # create-project уже поставил зависимости — только пересобираем автозагрузку
    # после переименования модуля.
    composer_cmd dump-autoload --quiet
    ok "Автозагрузка пересобрана."
elif [[ "$TARGET" != "local" ]]; then
    composer_cmd install --no-dev --optimize-autoloader --no-interaction
    ok "Зависимости установлены (--no-dev)."
fi

# --- Шаг: git ---------------------------------------------------------------------------
if [[ "$GIT_INIT" -eq 1 ]]; then
    step "Git-репозиторий"
    if [[ -d .git ]]; then
        info "Каталог уже под git — пропускаю."
    else
        CLEANUP_PATHS+=("$PROJECT_ROOT/.git")
        git init --quiet
        git symbolic-ref HEAD refs/heads/main
        if ! git check-ignore -q .env; then
            die ".env не игнорируется git (.gitignore повреждён?) — добавлять файлы в индекс опасно, останавливаюсь."
        fi
        # Коммит не делаем: сообщение и авторство первого коммита — дело проекта.
        git add -A
        ok "Репозиторий создан, файлы в индексе. Первый коммит — за вами."
    fi
fi

# ---------------------------------------------------------------------------
# Финал
# ---------------------------------------------------------------------------

trap - ERR INT TERM
CURRENT_STEP=""

# Рамка по ширине содержимого: длину считаем по тексту без ANSI-кодов,
# иначе правый край уезжает или остаётся дырка.
draw_box() {
    local lines=("$@") plains=() line plain len width=0 border pad i
    for line in "${lines[@]}"; do
        plain="$(printf '%s' "$line" | sed $'s/\033\\[[0-9;]*m//g')"
        plains+=("$plain")
        len=${#plain}
        if (( len > width )); then
            width=$len
        fi
    done
    border="$(printf '─%.0s' $(seq 1 $((width + 2))))"
    printf '%s\n' "${C_GREEN}┌${border}┐${C_RESET}"
    for i in "${!lines[@]}"; do
        pad=$((width - ${#plains[$i]}))
        printf '%s %s%*s %s\n' "${C_GREEN}│${C_RESET}" "${lines[$i]}" "$pad" "" "${C_GREEN}│${C_RESET}"
    done
    printf '%s\n' "${C_GREEN}└${border}┘${C_RESET}"
}

say ""
draw_box \
    "${C_GREEN}Готово!${C_RESET} Проект ${VENDOR}/${NAME} установлен." \
    "Каталог: ${PROJECT_ROOT}" \
    "Модуль:  local/modules/${VENDOR}.engine"
say ""
say "${C_TITLE}Что дальше:${C_RESET}"

NEXT_N=1
next() { # нумерованный шаг «что дальше»
    say "  $((NEXT_N)). $1"
    NEXT_N=$((NEXT_N + 1))
}

if [[ "$ORIG_PWD" != "$PROJECT_ROOT" ]]; then
    next "cd ${PROJECT_ROOT}"
fi

SETUP_URL="http://${HOST_NAME_V}.localhost/bitrixsetup.php"
if [[ "$TARGET" == "local" ]]; then
    if [[ "$BITRIX_SOURCE" == "setup" ]]; then
        if [[ "$INTERACTIVE" -eq 1 ]] && command -v xdg-open >/dev/null 2>&1 \
            && xdg-open "$SETUP_URL" >/dev/null 2>&1; then
            next "Установите ядро Битрикса — открыл в браузере: ${SETUP_URL}"
        else
            next "Установите ядро Битрикса в браузере: ${SETUP_URL}"
        fi
    elif [[ "$BITRIX_SOURCE" == "skip" ]]; then
        next "Установите ядро Битрикса: ./scripts/setup, затем откройте ${SETUP_URL}"
    fi
elif [[ "$TARGET" == "hosting" ]]; then
    next "Проверьте симлинк docroot: ${DOCROOT} → ${PROJECT_ROOT}/public"
fi

if [[ "$GIT_INIT" -eq 1 ]]; then
    next "Файлы уже в индексе — проверьте git status и сделайте первый коммит"
    if [[ "$TARGET" != "local" ]]; then
        next "Привяжите репозиторий проекта: git remote add origin <url> && git push -u origin main"
    fi
fi

say ""
say "Документация API после установки модуля: /api/doc"
