#!/usr/bin/env bash

set -euo pipefail
shopt -s extglob

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${PROJECT_ROOT}/.env"
COMPOSER_FILE="${PROJECT_ROOT}/composer.json"
MODULES_ROOT="${PROJECT_ROOT}/local/modules"
SETTINGS_FILE="${PROJECT_ROOT}/local/.settings.php"
DBCONN_FILE="${PROJECT_ROOT}/local/php_interface/dbconn.php"
PHP_MIN_VERSION_ID=80400
PHP_MIN_VERSION="8.4"
FORCE=false

if [ "${1:-}" = "--force" ]; then
    FORCE=true
fi

if [ ! -f "${ENV_FILE}" ]; then
    echo "[ERROR] Файл .env не найден. Сначала выполните: dl env"
    exit 1
fi

if [ -f "${SETTINGS_FILE}" ] && [ "${FORCE}" != true ]; then
    echo "[ERROR] Файл local/.settings.php уже существует."
    echo "        Проверьте его вручную или запустите: ./scripts/init --force"
    exit 1
fi

trim() {
    local value="$1"
    value="${value##+([[:space:]])}"
    value="${value%%+([[:space:]])}"
    printf '%s' "${value}"
}

load_env() {
    local line key value first_char last_char

    while IFS= read -r line || [ -n "${line}" ]; do
        line="${line//$'\r'/}"
        line="$(trim "${line}")"

        if [ -z "${line}" ] || [[ "${line}" == \#* ]]; then
            continue
        fi

        if [[ "${line}" == export\ * ]]; then
            line="${line#export }"
        fi

        if [[ "${line}" != *=* ]]; then
            echo "[ERROR] Некорректная строка .env: ${line}"
            exit 1
        fi

        key="$(trim "${line%%=*}")"
        value="$(trim "${line#*=}")"

        if [[ ! "${key}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
            echo "[ERROR] Некорректное имя переменной .env: ${key}"
            exit 1
        fi

        first_char="${value:0:1}"
        last_char="${value: -1}"
        if { [ "${first_char}" = '"' ] && [ "${last_char}" = '"' ]; } ||
            { [ "${first_char}" = "'" ] && [ "${last_char}" = "'" ]; }; then
            value="${value:1:${#value}-2}"
        fi

        printf -v "${key}" '%s' "${value}"
        export "${key}"
    done < "${ENV_FILE}"
}

# На shared-хостингах системный `php` часто старый (например, PHP 5.6 на Beget),
# а рядом лежат версионированные бинарники php8.4, php8.5 и т.д.
php_version_ok() {
    "$1" -r "exit(PHP_VERSION_ID >= ${PHP_MIN_VERSION_ID} ? 0 : 1);" >/dev/null 2>&1
}

detect_php() {
    local candidate

    if [ -n "${PHP_BIN:-}" ]; then
        if ! command -v "${PHP_BIN}" >/dev/null 2>&1; then
            echo "[ERROR] PHP_BIN=${PHP_BIN}: команда не найдена"
            exit 1
        fi
        if ! php_version_ok "${PHP_BIN}"; then
            echo "[ERROR] PHP_BIN=${PHP_BIN} — версия $("${PHP_BIN}" -r 'echo PHP_VERSION;' 2>/dev/null || echo '?'), требуется PHP >= ${PHP_MIN_VERSION}"
            exit 1
        fi
        return
    fi

    for candidate in php php8.5 php8.4; do
        if command -v "${candidate}" >/dev/null 2>&1 && php_version_ok "${candidate}"; then
            PHP_BIN="${candidate}"
            if [ "${candidate}" != "php" ]; then
                echo "[INFO] Использую ${candidate} (системный php: $(php -r 'echo PHP_VERSION;' 2>/dev/null || echo 'нет'))"
            fi
            return
        fi
    done

    PHP_BIN=""
}

php_bin_hint() {
    echo "        Системный php: $(php -r 'echo PHP_VERSION;' 2>/dev/null || echo 'не найден'), требуется PHP >= ${PHP_MIN_VERSION}."
    echo "        Укажите бинарник явно: PHP_BIN=php8.4 ./scripts/init (или добавьте PHP_BIN в .env)"
}

is_true() {
    case "${1:-}" in
        1|true|TRUE|yes|YES|y|Y|on|ON) return 0 ;;
        *) return 1 ;;
    esac
}

require_service() {
    local service_title="$1"
    local env_value="$2"
    local env_name="$3"

    if ! is_true "${env_value}"; then
        echo "[ERROR] Для ${service_title} нужно включить ${env_name}=true в .env"
        exit 1
    fi
}

normalize_list() {
    local value
    value="$(trim "${1:-}")"
    value="${value#[}"
    value="${value%]}"
    value="${value//,/ }"
    value="${value//\"/}"
    value="${value//\'/}"

    for item in ${value}; do
        printf '%s\n' "${item,,}"
    done
}

contains_connection() {
    local needle="$1"
    local item

    for item in "${CONNECTION_ITEMS[@]}"; do
        if [ "${item}" = "${needle}" ]; then
            return 0
        fi
    done

    return 1
}

add_connection() {
    local item="$1"

    if ! contains_connection "${item}"; then
        CONNECTION_ITEMS+=("${item}")
    fi
}

normalize_connection_name() {
    local item="$1"

    case "${item}" in
        db|database|default)
            printf '%s\n' "${DB_TYPE}"
            ;;
        mysql)
            if [ "${DB_TYPE}" = "mariadb" ]; then
                printf 'mariadb\n'
            else
                printf 'mysql\n'
            fi
            ;;
        mariadb)
            printf 'mariadb\n'
            ;;
        pgsql|postgres|postgresql)
            printf 'pgsql\n'
            ;;
        redis)
            printf 'redis\n'
            ;;
        memcache|memcached)
            printf 'memcache\n'
            ;;
        *)
            echo "[ERROR] Неизвестное соединение CONNECTIONS: ${item}" >&2
            exit 1
            ;;
    esac
}

build_default_connection_block() {
    cat <<PHP
            'default' => [
                'className' => ${DB_CLASS}::class,
                'host' => '${DB_HOST}',
                'database' => '${DB_NAME}',
                'login' => '${DB_USER}',
                'password' => '${DB_PASSWORD}',
                ${DB_OPTIONS}
            ],
PHP
}

build_redis_connection_block() {
    cat <<PHP
            'redis' => [
                'className' => RedisConnection::class,
                'host' => '${REDIS_HOST:-redis}',
                'port' => ${REDIS_PORT:-6379},
                'serializer' => \\Redis::SERIALIZER_JSON,
            ],
PHP
}

build_memcache_connection_block() {
    cat <<PHP
            'memcache' => [
                'className' => MemcacheConnection::class,
                'host' => '${MEMCACHED_HOST:-memcached}',
                'port' => ${MEMCACHED_PORT:-11211},
            ],
PHP
}

update_composer_name() {
    if [ ! -f "${COMPOSER_FILE}" ]; then
        echo "[SKIP] composer.json не найден"
        return
    fi

    if [ -z "${PHP_BIN}" ]; then
        echo "[WARN] PHP >= ${PHP_MIN_VERSION} не найден, composer.json не обновлен"
        return
    fi

    PROJECT_NAME="${PROJECT_NAME}" COMPOSER_FILE="${COMPOSER_FILE}" "${PHP_BIN}" -r '
        $file = getenv("COMPOSER_FILE");
        $name = getenv("PROJECT_NAME");
        $json = json_decode(file_get_contents($file), true, 512, JSON_THROW_ON_ERROR);
        $json["name"] = $name;
        file_put_contents(
            $file,
            json_encode($json, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) . PHP_EOL
        );
    '

    echo "[OK] composer.json: name=${PROJECT_NAME}"
}

# StudlyCase из vendor-части: focal -> Focal, my_company -> MyCompany.
# Используется как корень PHP-namespace модуля.
studly() {
    local input="$1" out="" part
    local IFS='_'
    read -ra _parts <<< "${input}"
    for part in "${_parts[@]}"; do
        [ -n "${part}" ] && out+="${part^}"
    done
    printf '%s' "${out}"
}

# Переименовывает shipped-модуль vendor.engine в <vendor>.engine:
# каталог, module ID, DI-идентификаторы, install-класс, PHP-namespace и
# psr-4 в composer.json. Демо-код внутри сохраняется — просто становится «твоим».
rename_engine_module() {
    local src_id="vendor.engine"
    local dst_id="${PROJECT_VENDOR}.engine"
    local src_dir="${MODULES_ROOT}/${src_id}"
    local dst_dir="${MODULES_ROOT}/${dst_id}"
    local ns_vendor
    ns_vendor="$(studly "${PROJECT_VENDOR}")"

    if [ "${dst_id}" = "${src_id}" ]; then
        # PROJECT_VENDOR=vendor — переименовывать нечего
        return
    fi

    if [ ! -d "${src_dir}" ]; then
        if [ -d "${dst_dir}" ]; then
            echo "[SKIP] Модуль уже переименован: local/modules/${dst_id}"
        else
            echo "[WARN] Модуль ${src_id} не найден, пропускаю переименование"
        fi
        return
    fi

    if [ -d "${dst_dir}" ]; then
        echo "[ERROR] Целевой модуль уже существует: local/modules/${dst_id}."
        echo "        Удалите его вручную, чтобы не потерять данные, и запустите init снова."
        exit 1
    fi

    if [ -z "${PHP_BIN}" ]; then
        echo "[ERROR] Для переименования модуля нужен PHP >= ${PHP_MIN_VERSION}"
        php_bin_hint
        exit 1
    fi

    SRC_DIR="${src_dir}" DST_DIR="${dst_dir}" \
        NS_VENDOR="${ns_vendor}" SRC_ID="${src_id}" DST_ID="${dst_id}" \
        PROJECT_VENDOR="${PROJECT_VENDOR}" COMPOSER_FILE="${COMPOSER_FILE}" \
        "${PHP_BIN}" -d display_errors=stderr /dev/stdin <<'PHP'
<?php
$srcDir       = getenv('SRC_DIR');
$dstDir       = getenv('DST_DIR');
$nsVendor     = getenv('NS_VENDOR');
$srcId        = getenv('SRC_ID');
$dstId        = getenv('DST_ID');
$vendor       = getenv('PROJECT_VENDOR');
$composerFile = getenv('COMPOSER_FILE');

$srcClass = str_replace('.', '_', $srcId); // vendor_engine
$dstClass = str_replace('.', '_', $dstId); // focal_engine
$srcNs    = 'Vendor\\Engine';
$dstNs    = $nsVendor . '\\Engine';

if (!rename($srcDir, $dstDir)) {
    fwrite(STDERR, "Не удалось переименовать каталог модуля: $srcDir -> $dstDir\n");
    exit(1);
}

$rii = new RecursiveIteratorIterator(
    new RecursiveDirectoryIterator($dstDir, FilesystemIterator::SKIP_DOTS)
);
foreach ($rii as $file) {
    if (!$file->isFile() || !preg_match('~\.(php|md|txt)$~', $file->getFilename())) {
        continue;
    }
    $path = $file->getPathname();
    $orig = file_get_contents($path);
    // strtr — одновременная нестыкующаяся замена за один проход:
    $new = strtr($orig, [
        $srcNs    => $dstNs,   // namespace Vendor\Engine -> Focal\Engine
        $srcId    => $dstId,   // module id + DI-идентификаторы + строки
        $srcClass => $dstClass // install-класс vendor_engine -> focal_engine
    ]);
    $new = preg_replace("~(PARTNER_NAME\\s*=\\s*)'vendor'~", "$1'" . $vendor . "'", $new);
    if ($new !== $orig) {
        file_put_contents($path, $new);
    }
}

$json = json_decode(file_get_contents($composerFile), true, 512, JSON_THROW_ON_ERROR);
if (isset($json['autoload']['psr-4'])) {
    $rebuilt = [];
    foreach ($json['autoload']['psr-4'] as $prefix => $dir) {
        if ($prefix === $srcNs . '\\') {
            $rebuilt[$dstNs . '\\'] = 'local/modules/' . $dstId . '/lib';
        } else {
            $rebuilt[$prefix] = $dir;
        }
    }
    $json['autoload']['psr-4'] = $rebuilt;
    file_put_contents(
        $composerFile,
        json_encode($json, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) . PHP_EOL
    );
}
PHP

    echo "[OK] Модуль переименован: ${src_id} -> ${dst_id} (namespace ${ns_vendor}\\Engine)"
    echo "[INFO] Обнови автозагрузку после init: composer dump-autoload (или composer install)"
}

load_env
detect_php

PROJECT_NAME="${PROJECT_NAME:-vendor/bitrix-boilerplate}"

if [[ ! "${PROJECT_NAME}" =~ ^[a-z0-9_]+/[a-z0-9_.-]+$ ]]; then
    echo "[ERROR] PROJECT_NAME должен быть в формате vendor/name"
    echo "        vendor: a-z, 0-9, _; name: a-z, 0-9, _, ., -"
    exit 1
fi

PROJECT_VENDOR="${PROJECT_NAME%%/*}"

DB_TYPE="mysql"
DB_CLASS="MysqliConnection"
DB_HOST="${MYSQL_HOST:-db}"
DB_NAME="${MYSQL_DATABASE:-db}"
DB_USER="${MYSQL_USER:-db}"
DB_PASSWORD="${MYSQL_PASSWORD:-db}"
DB_OPTIONS="'options' => 2,"

if [ -n "${POSTGRES_VERSION:-}" ]; then
    DB_TYPE="pgsql"
    DB_CLASS="PgsqlConnection"
    DB_HOST="${POSTGRES_HOST:-pgsql}"
    DB_NAME="${POSTGRES_DB:-db}"
    DB_USER="${POSTGRES_USER:-db}"
    DB_PASSWORD="${POSTGRES_PASSWORD:-db}"
    DB_OPTIONS="'options' => 2,
                'charset' => 'utf-8',
                'include_after_connected' => '',"
elif [ -n "${MARIADB_VERSION:-}" ]; then
    DB_TYPE="mariadb"
fi

apply_bitrix_settings_override() {
    local bitrix_settings="${PROJECT_ROOT}/bitrix/.settings.php"
    local app_env="${APP_ENV:-local}"
    local result class=""

    if [ "${app_env,,}" = "local" ]; then
        return
    fi

    if [ ! -f "${bitrix_settings}" ]; then
        echo "[ERROR] APP_ENV=${app_env}, но bitrix/.settings.php не найден."
        echo "        Сначала установите Битрикс или поменяйте APP_ENV=local в .env."
        exit 1
    fi

    if [ -z "${PHP_BIN}" ]; then
        echo "[ERROR] Не могу прочитать bitrix/.settings.php: нет подходящего PHP."
        php_bin_hint
        exit 1
    fi

    echo "[INFO] Беру креды БД из bitrix/.settings.php (APP_ENV=${app_env}, ${PHP_BIN})"

    if ! result="$(BITRIX_SETTINGS_FILE="${bitrix_settings}" "${PHP_BIN}" -d display_errors=stderr -r '
        $file = getenv("BITRIX_SETTINGS_FILE");
        $settings = @include $file;
        if (!is_array($settings)) {
            fwrite(STDERR, "bitrix/.settings.php не вернул массив\n");
            exit(1);
        }
        $default = $settings["connections"]["value"]["default"] ?? null;
        if (!is_array($default)) {
            fwrite(STDERR, "В bitrix/.settings.php нет connections.value.default\n");
            exit(1);
        }
        foreach (["className", "host", "database", "login", "password"] as $k) {
            $v = (string)($default[$k] ?? "");
            $v = str_replace(["\r", "\n"], ["", "\\n"], $v);
            echo $k . "=" . $v . "\n";
        }
    ')"; then
        echo "[ERROR] Не удалось прочитать bitrix/.settings.php (${PHP_BIN} завершился с ошибкой, детали выше)."
        exit 1
    fi

    while IFS='=' read -r key value; do
        case "${key}" in
            className) class="${value}" ;;
            host) DB_HOST="${value}" ;;
            database) DB_NAME="${value}" ;;
            login) DB_USER="${value}" ;;
            password) DB_PASSWORD="${value}" ;;
        esac
    done <<< "${result}"

    case "${class}" in
        *Pgsql*)
            DB_TYPE="pgsql"
            DB_CLASS="PgsqlConnection"
            DB_OPTIONS="'options' => 2,
                'charset' => 'utf-8',
                'include_after_connected' => '',"
            ;;
        *Mysqli*)
            DB_CLASS="MysqliConnection"
            ;;
    esac
}

apply_bitrix_settings_override

CACHE="${CACHE:-files}"
SESSION="${SESSION:-file}"
CACHE="${CACHE,,}"
SESSION="${SESSION,,}"

CONNECTION_ITEMS=()
if [ -n "${CONNECTIONS:-}" ]; then
    while IFS= read -r connection; do
        if [ -n "${connection}" ]; then
            add_connection "$(normalize_connection_name "${connection}")"
        fi
    done < <(normalize_list "${CONNECTIONS}")
else
    CONNECTION_ITEMS=("${DB_TYPE}")
fi

if ! contains_connection "${DB_TYPE}"; then
    echo "[ERROR] CONNECTIONS должен содержать текущую базу данных: ${DB_TYPE}"
    exit 1
fi

for connection in "${CONNECTION_ITEMS[@]}"; do
    case "${connection}" in
        "${DB_TYPE}"|redis|memcache) ;;
        *)
            echo "[ERROR] CONNECTIONS=${connection} не соответствует базе данных из .env: ${DB_TYPE}"
            exit 1
            ;;
    esac
done

case "${CACHE}" in
    redis)
        require_service "кэша Redis" "${REDIS:-}" "REDIS"
        CACHE_USE="use Bitrix\\Main\\Data\\CacheEngineRedis;"
        CACHE_BLOCK="'cache' => [
        'value' => [
            'type' => [
                'class_name' => CacheEngineRedis::class,
                'extension' => 'redis',
            ],
            'sid' => \$_SERVER['DOCUMENT_ROOT'] . '#01',
            'redis' => [
                'host' => '${REDIS_HOST:-redis}',
                'port' => ${REDIS_PORT:-6379},
            ],
        ],
    ],"
        ;;
    memcache|memcached)
        require_service "кэша Memcached" "${MEMCACHED:-}" "MEMCACHED"
        CACHE="memcache"
        CACHE_USE=""
        CACHE_BLOCK="'cache' => [
        'value' => [
            'type' => 'memcache',
            'sid' => \$_SERVER['DOCUMENT_ROOT'] . '#01',
            'memcache' => [
                'host' => '${MEMCACHED_HOST:-memcached}',
                'port' => ${MEMCACHED_PORT:-11211},
            ],
        ],
        'readonly' => false,
    ],"
        ;;
    files|file)
        CACHE="files"
        CACHE_USE=""
        CACHE_BLOCK="'cache' => [
        'value' => [
            'type' => 'files',
        ],
    ],"
        ;;
    none)
        CACHE_USE=""
        CACHE_BLOCK="'cache' => [
        'value' => [
            'type' => 'none',
        ],
    ],"
        ;;
    *)
        echo "[ERROR] Неизвестное значение CACHE=${CACHE}"
        exit 1
        ;;
esac

case "${SESSION}" in
    redis)
        require_service "сессий Redis" "${REDIS:-}" "REDIS"
        SESSION_HANDLER="'type' => 'redis',
                                'host' => '${REDIS_HOST:-redis}',
                                'port' => ${REDIS_PORT:-6379},"
        ;;
    memcache|memcached)
        require_service "сессий Memcached" "${MEMCACHED:-}" "MEMCACHED"
        SESSION="memcache"
        SESSION_HANDLER="'type' => 'memcache',
                                'host' => '${MEMCACHED_HOST:-memcached}',
                                'port' => ${MEMCACHED_PORT:-11211},"
        ;;
    database)
        SESSION_HANDLER="'type' => 'database',"
        ;;
    files|file)
        SESSION="file"
        SESSION_HANDLER="'type' => 'file',"
        ;;
    *)
        echo "[ERROR] Неизвестное значение SESSION=${SESSION}"
        exit 1
        ;;
esac

if contains_connection redis; then
    require_service "соединения Redis" "${REDIS:-}" "REDIS"
fi

if contains_connection memcache; then
    require_service "соединения Memcached" "${MEMCACHED:-}" "MEMCACHED"
fi

CONNECTIONS_BLOCK="$(build_default_connection_block)"

if contains_connection redis; then
    CONNECTIONS_BLOCK+=$'\n'"$(build_redis_connection_block)"
fi

if contains_connection memcache; then
    CONNECTIONS_BLOCK+=$'\n'"$(build_memcache_connection_block)"
fi

# Собираем только те use-импорты, которые реально используются в сгенерированном
# файле: класс активной БД + классы включённых соединений (+ CacheEngineRedis из CACHE_USE).
USE_STATEMENTS=()
if [ -n "${CACHE_USE}" ]; then
    USE_STATEMENTS+=("${CACHE_USE}")
fi
if [ "${DB_CLASS}" = "PgsqlConnection" ]; then
    USE_STATEMENTS+=('use Bitrix\Main\DB\PgsqlConnection;')
else
    USE_STATEMENTS+=('use Bitrix\Main\DB\MysqliConnection;')
fi
if contains_connection redis; then
    USE_STATEMENTS+=('use Bitrix\Main\Data\RedisConnection;')
fi
if contains_connection memcache; then
    USE_STATEMENTS+=('use Bitrix\Main\Data\MemcacheConnection;')
fi
USE_BLOCK="$(printf '%s\n' "${USE_STATEMENTS[@]}")"

echo "[INFO] Инициализируем проект: ${PROJECT_NAME}"
echo "[INFO] База данных: ${DB_TYPE}"
echo "[INFO] Кэш: ${CACHE}"
echo "[INFO] Сессии: ${SESSION}"
echo "[INFO] Соединения: ${CONNECTION_ITEMS[*]}"

update_composer_name
rename_engine_module

echo "[INFO] Генерируем local/.settings.php..."

# Пишем через tmp+mv: перезапись файла на месте ломает hardlink-бэкапы
# (их делает scripts/bootstrap для отката при ошибке).
cat > "${SETTINGS_FILE}.tmp" <<PHP
<?php

${USE_BLOCK}

return [
    'connections' => [
        'value' => [
${CONNECTIONS_BLOCK}
        ],
        'readonly' => true,
    ],
    'exception_handling' => [
        'value' => [
            'debug' => ${APP_DEBUG:-false},
            'handled_errors_types' => E_ALL & ~E_NOTICE & ~E_USER_NOTICE,
            'exception_errors_types' => E_ALL
                & ~E_NOTICE
                & ~E_WARNING
                & ~E_USER_WARNING
                & ~E_USER_NOTICE
                & ~E_COMPILE_WARNING
                & ~E_DEPRECATED,
            'ignore_silence' => false,
            'assertion_throws_exception' => true,
            'assertion_error_type' => E_USER_ERROR,
            'log' => [
                'settings' => [
                    // Путь с ведущим "/" Битрикс считает абсолютным путём ФС,
                    // поэтому строим его от корня проекта (local/..).
                    'file' => dirname(__DIR__) . '/logs/error.log',
                    'log_size' => 1000000,
                ],
            ],
        ],
        'readonly' => false,
    ],
    ${CACHE_BLOCK}
    'session' => [
        'value' => [
            'mode' => 'default',
            'handlers' => [
                'general' => [
                    ${SESSION_HANDLER}
                ],
            ],
        ],
    ],
    'routing' => [
        'value' => [
            'config' => ['api.php'],
        ],
    ],
];
PHP
mv "${SETTINGS_FILE}.tmp" "${SETTINGS_FILE}"

if [ ! -f "${DBCONN_FILE}" ]; then
    cp "${PROJECT_ROOT}/local/php_interface/dbconn.php.example" "${DBCONN_FILE}"
    echo "[OK] Создан файл: local/php_interface/dbconn.php"
fi

echo "[SUCCESS] Инициализация завершена."
